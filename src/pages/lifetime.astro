---
import Base from "../layouts/Base.astro";
import "../styles/life.css";
---
<Base title="Lifetime calculator" description="Your life as an hourglass — one grain of sand per week.">
  <div class="life-root">
    <section style="margin-top:2.2rem">
      <h1>Lifetime calculator</h1>
      <p class="muted" style="margin-top:0">
        Every grain of sand is one week of your life. What has fallen is lived; what is still on top is ahead of you.
        Enter your birthday, an expected age (the Swiss average is about 82 for men and 86 for women) and the age at
        which you expect to become less active. Hover or tap a grain to see which week it is.
      </p>
    </section>

    <form class="card life-form" id="life-form" onsubmit="return false">
      <label>Birthday<input type="date" name="birth" value="2000-01-01" required /></label>
      <label>Expected age<input type="number" name="exp" value="84" min="1" max="120" required /></label>
      <label>Inactive from age<input type="number" name="inactive" value="75" min="1" max="120" required /></label>
    </form>

    <p class="life-stats" id="life-stats" aria-live="polite"></p>
    <div id="hourglass"></div>

    <p class="muted" style="margin-top:1.5rem">
      This can feel intimidating. It can also be motivation not to miss out on what you really want to do.
    </p>
  </div>
</Base>

<style>
  .life-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .8rem; margin-top: 1rem; }
  .life-form label { display: flex; flex-direction: column; gap: .3rem; font-size: .85rem; color: var(--muted); }
  .life-form input {
    font: inherit; font-size: 1rem; color: var(--text); background: var(--bg);
    border: 1px solid var(--border); border-radius: 8px; padding: .5rem .6rem; min-height: 42px;
  }
  .life-stats { font-size: 1.05rem; margin: 1.2rem 0 0; min-height: 1.6em; }
</style>

<script>
  import { fmtN, makeLife } from "../lib/life";
  import { renderHourglass } from "../lib/viz-hourglass";

  const form = document.getElementById("life-form") as HTMLFormElement;
  const stats = document.getElementById("life-stats")!;
  const target = document.getElementById("hourglass")!;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  try {
    const saved = JSON.parse(localStorage.getItem("lifetime") || "null");
    if (saved) for (const k of ["birth", "exp", "inactive"]) if (saved[k] != null) field(k).value = saved[k];
  } catch {}

  let stop = () => {};
  function render() {
    const birth = new Date(field("birth").value + "T00:00:00");
    const exp = Math.round(+field("exp").value), inactive = Math.round(+field("inactive").value);
    if (isNaN(+birth) || birth >= new Date() || !(exp > 0 && exp <= 120) || !(inactive > 0 && inactive <= 120)) {
      stats.textContent = "Please enter a birthday in the past and ages between 1 and 120.";
      stop(); target.replaceChildren();
      return;
    }
    try { localStorage.setItem("lifetime", JSON.stringify({ birth: field("birth").value, exp, inactive })); } catch {}
    const life = makeLife(birth, exp, inactive);
    const left = Math.max(0, life.total - life.here);
    const activeEnd = Math.min(inactive, exp) * 52;
    stats.innerHTML = life.here >= exp * 52
      ? `You've lived <b>${fmtN(life.lived)}</b> weeks — past your expected age. Every week is a bonus.`
      : `You've lived <b>${fmtN(life.lived)}</b> weeks (${Math.round((life.here / life.total) * 100)}%). ` +
        `About <b>${fmtN(left)}</b> remain, <b>${fmtN(Math.max(0, activeEnd - life.here))}</b> of them active.`;
    stop();
    stop = renderHourglass(target, life);
  }

  let timer = 0;
  const later = () => { clearTimeout(timer); timer = window.setTimeout(render, 150); };
  form.addEventListener("input", later);
  let lastW = innerWidth;
  addEventListener("resize", () => { if (innerWidth !== lastW) { lastW = innerWidth; later(); } });
  new MutationObserver(later).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", later);
  render();
</script>
